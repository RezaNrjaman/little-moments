# Little Moments - Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to Git.
# NEVER use NEXT_PUBLIC_* for secrets.

# Supabase project URL (safe to expose, used to identify the project)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase secret (service role) key. Server only. Never expose to the client.
SUPABASE_SECRET_KEY=

# Hash of the shared scrapbook password.
# Generate with: node scripts/hash-password.mjs "your-password"
# (Format: scrypt:<salt>:<hash> - do not wrap the value in quotes.)
SCRAPBOOK_PASSWORD_HASH=

# High entropy random secret used to sign session and upload tickets.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Optional: persistent rate limiting for login (serverless safe) ---
# If omitted, an in-memory best effort limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
